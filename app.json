{
  "expo": {
    "name": "dispatch.io",
    "slug": "dispatch-io",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-v2.png",
    "scheme": "dispatchio",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo-v2.png",
        "backgroundImage": "./assets/images/logo-v2.png",
        "monochromeImage": "./assets/images/logo-v2.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.emmanuelnwafor.dispatchio"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-v2.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "51e0883c-7091-4cb8-95c6-dcfeb6758b2c"
      }
    }
  }
}
